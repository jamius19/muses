ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Must support tool calling. Append ":online" to enable OpenRouter web search.
OPENROUTER_MODEL=openai/gpt-5-mini

# Optional
# DATABASE_PATH=data/muses.db
# CORS_ORIGIN=http://localhost:3000
# PORT=3001
# HOST=127.0.0.1
